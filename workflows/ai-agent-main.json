    {
      "parameters": {
        "jsCode": "const texto = $json.output;\n\n// Se não veio texto ou não é string, retorna vazio sem quebrar\nif (!texto || typeof texto !== 'string') {\n  return [\n    {\n      json: {\n        message: texto || '',\n        part: 1,\n        total: 1,\n      },\n    },\n  ];\n}\n\n// Divide o texto onde tiver 2 ou mais quebras de linha\nconst partes = texto\n  .split(/\\n\\n+/)\n  .map(p => p.trim())\n  .filter(p => p.length > 0);\n\n// Se não encontrou partes, envia o texto inteiro\nif (partes.length === 0) {\n  return [\n    {\n      json: {\n        message: texto,\n        part: 1,\n        total: 1,\n      },\n    },\n  ];\n}\n\nconst total = partes.length;\n\n// Transforma cada parágrafo em um item separado no n8n\nreturn partes.map((msg, idx) => ({\n  json: {\n    message: msg,\n    part: idx + 1,\n    total,\n  },\n}));"
      },
