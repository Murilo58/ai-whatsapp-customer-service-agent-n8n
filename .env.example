# =============================================================================
# AI WhatsApp Customer Service Agent - example environment file
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# NEVER commit `.env` or real values. NEVER put secrets inside the workflow JSON.
# All values below are placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# n8n
# -----------------------------------------------------------------------------
N8N_BASE_URL=https://YOUR_N8N_BASE_URL
N8N_WEBHOOK_ID=YOUR_WEBHOOK_ID
N8N_MCP_ENDPOINT=YOUR_MCP_ENDPOINT
N8N_MCP_ENDPOINT_ID=YOUR_MCP_ENDPOINT_ID

# -----------------------------------------------------------------------------
# WhatsApp provider (Evolution API or equivalent)
# -----------------------------------------------------------------------------
EVOLUTION_API_BASE_URL=https://YOUR_EVOLUTION_API_BASE_URL
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY
EVOLUTION_INSTANCE=YOUR_EVOLUTION_INSTANCE
WHATSAPP_NOTIFICATION_NUMBER=YOUR_PHONE_NUMBER

# -----------------------------------------------------------------------------
# LLM provider (chat + audio transcription)
# -----------------------------------------------------------------------------
LLM_PROVIDER=YOUR_LLM_PROVIDER
LLM_API_KEY=YOUR_LLM_API_KEY
LLM_CHAT_MODEL=YOUR_LLM_CHAT_MODEL
LLM_AUDIO_MODEL=YOUR_LLM_AUDIO_MODEL

# -----------------------------------------------------------------------------
# Embeddings provider
# -----------------------------------------------------------------------------
EMBEDDINGS_PROVIDER=YOUR_EMBEDDINGS_PROVIDER
EMBEDDINGS_API_KEY=YOUR_EMBEDDINGS_API_KEY
EMBEDDINGS_MODEL=YOUR_EMBEDDINGS_MODEL

# -----------------------------------------------------------------------------
# Supabase (vector store + REST)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_VECTOR_TABLE=documents
SUPABASE_VECTOR_QUERY=match_documents

# -----------------------------------------------------------------------------
# PostgreSQL (conversational memory + leads)
# -----------------------------------------------------------------------------
POSTGRES_HOST=YOUR_POSTGRES_HOST
POSTGRES_PORT=5432
POSTGRES_DATABASE=YOUR_POSTGRES_DATABASE
POSTGRES_USER=YOUR_POSTGRES_USER
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# -----------------------------------------------------------------------------
# Redis (message buffer / debounce)
# -----------------------------------------------------------------------------
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# -----------------------------------------------------------------------------
# Google Drive (knowledge base source)
# -----------------------------------------------------------------------------
GOOGLE_DRIVE_CLIENT_ID=YOUR_GOOGLE_DRIVE_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=YOUR_GOOGLE_DRIVE_CLIENT_SECRET
GOOGLE_DRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID

# -----------------------------------------------------------------------------
# Google Calendar (scheduling)
# -----------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=YOUR_GOOGLE_CALENDAR_CLIENT_ID
GOOGLE_CALENDAR_CLIENT_SECRET=YOUR_GOOGLE_CALENDAR_CLIENT_SECRET
GOOGLE_CALENDAR_ID=YOUR_GOOGLE_CALENDAR_ID

# -----------------------------------------------------------------------------
# Agent behavior
# -----------------------------------------------------------------------------
AGENT_COMPANY_NAME=YOUR_COMPANY_NAME
AGENT_ASSISTANT_NAME=YOUR_ASSISTANT_NAME
CONVERSATION_RESET_KEYWORD=YOUR_RESET_KEYWORD
